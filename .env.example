DJANGO_SECRET_KEY=change-me-in-dot-env-this-is-only-a-development-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=0
DJANGO_BEHIND_TLS_PROXY=0
TIME_ZONE=Europe/Moscow

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin-dev-password
DJANGO_SUPERUSER_EMAIL=admin@example.com

POSTGRES_DB=promo
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=

PROMO_START_DATE=2026-01-01
PROMO_END_DATE=2026-12-31
PROMO_MIN_AMOUNT=1000
PROMO_SITE_URL=/rules/
RECEIPT_MAX_RESUBMISSIONS=2
RECEIPT_PHOTO_MAX_MB=5
RECEIPT_SUBMIT_RATE_LIMIT=10
RECEIPT_STATUS_POLL_SECONDS=15

WEB_CONCURRENCY=3
WEB_THREADS=2
WEB_PORT=8000
